# Configuration de l'application
PORT=3000
NODE_ENV=production

# Base de données MongoDB (MongoDB Atlas recommandé pour Render)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/ticket-verif?retryWrites=true&w=majority

# Session secret (générez une chaîne aléatoire longue)
SESSION_SECRET=votre_secret_session_tres_long_et_aleatoire_ici

# Email (Gmail ou autre SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=votre.email@gmail.com
EMAIL_PASS=votre_mot_de_passe_application_gmail

# Email de l'administrateur
ADMIN_EMAIL=admin@votre-domaine.com

# URL du site (sera automatiquement définie par Render)
SITE_URL=https://votre-app.onrender.com

# Mot de passe admin (changez-le !)
ADMIN_PASSWORD=AdminSecure2024!
